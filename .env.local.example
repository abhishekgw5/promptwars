# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenWeatherMap API Key (free at https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Set to your deployed URL on Vercel (e.g. https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# Demo user credentials (evaluators can use these to sign in)
DEMO_USER_EMAIL=demo@monsoonguard.app
DEMO_USER_PASSWORD=Monsoon@2025

# Optional: AI Model override (default: meta-llama/llama-4-scout-17b-16e-instruct)
# AI_MODEL=llama-3.3-70b-versatile
